[colors]
background = #1e1e2e
foreground = #cdd6f4
foreground-alt = #6c7086
primary = #89b4fa
red = #f38ba8
green = #a6e3a1

[bar/main]
monitor = ${env:MONITOR}
width = 100%
height = 24
offset-y = 0
background = ${colors.background}
foreground = ${colors.foreground}

font-0 = JetBrainsMono Nerd Font:size=11;1
font-1 = JetBrainsMono Nerd Font:size=13;2

modules-left = i3
modules-right = mediaplayer network bluetooth date

wm-restack = i3
enable-ipc = true

separator = "  "

[module/i3]
type = internal/i3
format = <label-state>
label-focused = %icon% %name%
label-focused-foreground = ${colors.primary}
label-focused-underline = ${colors.primary}
label-unfocused = %icon% %name%
label-unfocused-foreground = ${colors.foreground-alt}
label-urgent = %icon% %name%
label-urgent-foreground = ${colors.red}

[module/date]
type = internal/date
interval = 5
time = %H:%M
time-alt = %Y-%m-%d %H:%M:%S
label = %time%
label-foreground = ${colors.foreground}

[module/network]
type = internal/network
interface = wlan0
interval = 3
label-connected = %{F#74c7ec}󰤨%{F-} %local_ip%
label-disconnected = %{F#f38ba8}󰤯%{F-} offline
label-disconnected-foreground = ${colors.red}

[module/bluetooth]
type = custom/script
exec = bluetooth-status
interval = 10
label = %output%
format-foreground = ${colors.foreground}

[module/mediaplayer]
type = internal/mpd
host = 127.0.0.1
port = 6600
format-online = %{F#f9e2af}󰎮%{F-} %title%
format-online-foreground = ${colors.foreground}
format-offline =
label-offline =   

[module/mediaplayer]
type = custom/script
exec = mpv --idle=yes --input-ipc-server=/tmp/mpvsocket get mediaplayback --format 2>/dev/null || echo "No playback"
interval = 3
label = %{F#f9e2af}󰎮%{F-} %output%   